{
  "name": "afterimage",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:studio": "pnpm --dir apps/studio-desktop dev",
    "dev:live": "pnpm --dir apps/live-desktop dev",
    "dev:appliance": "cd apps/live-appliance && go run ./cmd/afterimage-appliance",
    "foundry:run": "node scripts/transition-foundry.mjs run",
    "foundry:generate": "node scripts/transition-foundry.mjs generate",
    "foundry:analyze": "node scripts/transition-foundry.mjs analyze",
    "foundry:review": "node scripts/transition-foundry.mjs review"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "turbo": "^2.8.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
