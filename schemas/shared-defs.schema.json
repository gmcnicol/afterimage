{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterimage.local/schemas/shared-defs.schema.json",
  "$defs": {
    "idString": {
      "type": "string",
      "minLength": 1
    },
    "runtimeMode": {
      "type": "string",
      "enum": ["studio", "live-desktop", "live-appliance"]
    },
    "presetFamily": {
      "type": "string",
      "enum": ["vhs", "liminal", "imagined-futures", "glitch"]
    },
    "midiBindingMode": {
      "type": "string",
      "enum": ["set", "toggle", "scale", "trigger"]
    },
    "probeStreamType": {
      "type": "string",
      "enum": ["video", "audio", "subtitle", "data", "unknown"]
    },
    "mediaType": {
      "type": "string",
      "enum": ["video", "image", "audio"]
    },
    "assetRole": {
      "type": "string",
      "enum": ["source", "music", "transition-mask", "transition-overlay"]
    },
    "importStatus": {
      "type": "string",
      "enum": ["ready", "excluded", "missing"]
    },
    "analysisStatus": {
      "type": "string",
      "enum": ["pending", "queued", "running", "completed", "failed"]
    },
    "cutStatus": {
      "type": "string",
      "enum": ["new", "kept", "rejected", "favorite"]
    },
    "audioChangeKind": {
      "type": "string",
      "enum": ["energy-shift", "spectral-change", "silence-start", "silence-end", "onset-cluster"]
    },
    "audioChangeSource": {
      "type": "string",
      "enum": ["astats", "aspectralstats", "ebur128", "silencedetect", "derived"]
    },
    "syncEventSource": {
      "type": "string",
      "enum": ["audio-change", "beat", "downbeat", "midi", "manual"]
    },
    "syncEventKind": {
      "type": "string",
      "enum": ["change", "accent", "section", "silence-boundary", "cue", "beat", "downbeat"]
    },
    "syncMode": {
      "type": "string",
      "enum": ["texture", "pulse", "performance", "hybrid", "custom"]
    },
    "transitionStyle": {
      "type": "string",
      "enum": ["cut", "crossfade", "mask"]
    },
    "filterStackScope": {
      "type": "string",
      "enum": ["sequence", "clip", "preset"]
    },
    "automationTargetProperty": {
      "type": "string",
      "enum": ["mix", "contrast", "brightness", "radius", "strength"]
    },
    "supportedFilterType": {
      "type": "string",
      "enum": ["contrast", "brightness", "blur", "bloom-soft", "glitch-bands", "chroma-bleed"]
    },
    "sceneActivationKind": {
      "type": "string",
      "enum": ["timeline", "manual", "capture", "entropy", "archive", "audio"]
    },
    "sceneLayerScope": {
      "type": "string",
      "enum": ["composition", "scene", "scene-transition", "source-clip", "archive-segment", "behaviour", "diagnostic"]
    },
    "sceneLayerContribution": {
      "type": "string",
      "enum": ["source", "texture", "mask", "transition-overlay", "atmospheric-overlay", "generated-material", "archive-resurfacing", "field-visualization", "diagnostic"]
    },
    "sceneLayerInfluence": {
      "type": "string",
      "enum": ["pixels", "mask", "field", "modulation", "material", "diagnostic"]
    },
    "sceneLayerBlendIntent": {
      "type": "string",
      "enum": ["normal", "mix", "add-luma", "screen", "multiply", "masked-merge"]
    },
    "sceneLayerRenderPassKind": {
      "type": "string",
      "enum": ["source", "mask", "overlay", "behaviour", "diagnostic"]
    },
    "capturePolicy": {
      "type": "string",
      "enum": ["ignore", "record", "replay-critical"]
    },
    "modulationSourceKind": {
      "type": "string",
      "enum": ["automation-lane", "midi-binding", "capture-event", "entropy-state", "manual"]
    },
    "modulationTargetKind": {
      "type": "string",
      "enum": ["filter", "scene-climate", "layer", "composition"]
    },
    "modulationEndpointKind": {
      "type": "string",
      "enum": [
        "automation-lane",
        "midi-binding",
        "capture-event",
        "entropy-state",
        "manual",
        "filter",
        "scene-climate",
        "layer",
        "composition",
        "modulation-route",
        "scene"
      ]
    },
    "modulationMappingKind": {
      "type": "string",
      "enum": ["linear", "exponential", "step", "toggle", "trigger"]
    },
    "captureSessionStatus": {
      "type": "string",
      "enum": ["open", "completed"]
    },
    "captureTimebaseKind": {
      "type": "string",
      "enum": ["project-ms", "composition-ms", "sequence-ms"]
    },
    "captureEventKind": {
      "type": "string",
      "enum": ["input", "modulation", "entropy", "transport", "manual"]
    },
    "assistedGenerationStrategy": {
      "type": "string",
      "enum": ["manual", "chronological", "marker-aware", "motif", "seeded-constrained"]
    },
    "jsonPrimitive": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "jsonValue": {
      "anyOf": [
        { "$ref": "#/$defs/jsonPrimitive" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "pathRef": {
      "type": "object",
      "required": ["absolutePath"],
      "properties": {
        "absolutePath": { "type": "string", "minLength": 1 },
        "relativePath": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["createdAt"],
      "properties": {
        "createdAt": { "type": "string", "minLength": 1 },
        "updatedAt": { "type": "string", "minLength": 1 },
        "projectFileName": { "type": "string", "minLength": 1 },
        "currentProfileSet": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "mediaAsset": {
      "type": "object",
      "required": ["id", "filename", "mediaType", "path", "hasAudio"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "filename": { "type": "string", "minLength": 1 },
        "mediaType": { "$ref": "#/$defs/mediaType" },
        "assetRole": { "$ref": "#/$defs/assetRole" },
        "path": { "$ref": "#/$defs/pathRef" },
        "label": { "type": "string", "minLength": 1 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "frameRate": { "type": "number", "minimum": 0 },
        "hasAudio": { "type": "boolean", "default": true },
        "importStatus": { "$ref": "#/$defs/importStatus", "default": "ready" },
        "analysisStatus": { "$ref": "#/$defs/analysisStatus", "default": "pending" },
        "favorite": { "type": "boolean", "default": false },
        "tags": { "$ref": "#/$defs/stringArray" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "presetFilter": {
      "type": "object",
      "required": ["type", "amount"],
      "properties": {
        "type": { "$ref": "#/$defs/supportedFilterType" },
        "amount": { "type": "number", "minimum": 0, "maximum": 1 },
        "mix": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
        "seed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "preset": {
      "type": "object",
      "required": ["id", "name", "family", "filters"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "name": { "type": "string", "minLength": 1 },
        "family": { "$ref": "#/$defs/presetFamily" },
        "filters": {
          "type": "array",
          "items": { "$ref": "#/$defs/presetFilter" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "probeStream": {
      "type": "object",
      "required": ["codecType"],
      "properties": {
        "codecType": { "$ref": "#/$defs/probeStreamType" },
        "codecName": { "type": "string" },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "sampleRate": { "type": "integer", "minimum": 0 },
        "channels": { "type": "integer", "minimum": 0 },
        "avgFrameRate": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "probeMetadata": {
      "type": "object",
      "required": ["durationMs", "streams"],
      "properties": {
        "formatName": { "type": "string" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "bitRate": { "type": "integer", "minimum": 0 },
        "streams": {
          "type": "array",
          "items": { "$ref": "#/$defs/probeStream" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "sceneCut": {
      "type": "object",
      "required": ["timeMs", "score"],
      "properties": {
        "timeMs": { "type": "integer", "minimum": 0 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "thumbnailReference": {
      "type": "object",
      "required": ["id", "timeMs", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "timeMs": { "type": "integer", "minimum": 0 },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "waveformSummary": {
      "type": "object",
      "required": ["durationMs", "peaks"],
      "properties": {
        "durationMs": { "type": "integer", "minimum": 0 },
        "peaks": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "audioChangeEvent": {
      "type": "object",
      "required": ["id", "timeMs", "kind", "source", "strength"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "timeMs": { "type": "integer", "minimum": 0 },
        "kind": { "$ref": "#/$defs/audioChangeKind" },
        "source": { "$ref": "#/$defs/audioChangeSource" },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "label": { "type": "string", "minLength": 1 },
        "metadata": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/jsonPrimitive" },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "audioChangeTrack": {
      "type": "object",
      "required": ["id", "assetId", "generatedBy", "events"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "assetId": { "$ref": "#/$defs/idString" },
        "generatedBy": { "$ref": "#/$defs/stringArray" },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/audioChangeEvent" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "syncEvent": {
      "type": "object",
      "required": ["id", "timeMs", "source", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "timeMs": { "type": "integer", "minimum": 0 },
        "source": { "$ref": "#/$defs/syncEventSource" },
        "kind": { "$ref": "#/$defs/syncEventKind" },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "label": { "type": "string", "minLength": 1 },
        "audioChangeEventId": { "$ref": "#/$defs/idString" }
      },
      "additionalProperties": false
    },
    "syncEventTrack": {
      "type": "object",
      "required": ["id", "assetId", "events"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "assetId": { "$ref": "#/$defs/idString" },
        "derivedFromTrackId": { "$ref": "#/$defs/idString" },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/syncEvent" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "beatEvent": {
      "type": "object",
      "required": ["id", "timeMs", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "timeMs": { "type": "integer", "minimum": 0 },
        "kind": {
          "type": "string",
          "enum": ["beat", "downbeat"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "bpm": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "beatTrack": {
      "type": "object",
      "required": ["id", "assetId", "events"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "assetId": { "$ref": "#/$defs/idString" },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/beatEvent" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "midiGestureEvent": {
      "type": "object",
      "required": ["id", "timeMs", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "timeMs": { "type": "integer", "minimum": 0 },
        "source": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "label": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "midiGestureTrack": {
      "type": "object",
      "required": ["id", "assetId", "events"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "assetId": { "$ref": "#/$defs/idString" },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/midiGestureEvent" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "lumaSummary": {
      "type": "object",
      "required": ["average", "minimum", "maximum"],
      "properties": {
        "average": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimum": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximum": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "motionSummary": {
      "type": "object",
      "required": ["average", "peak"],
      "properties": {
        "average": { "type": "number", "minimum": 0, "maximum": 1 },
        "peak": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "analysisSummary": {
      "type": "object",
      "required": ["sceneCount"],
      "properties": {
        "sceneCount": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "thumbnailCount": { "type": "integer", "minimum": 0 },
        "waveformGenerated": { "type": "boolean" },
        "lumaAverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "motionAverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "changeEventCount": { "type": "integer", "minimum": 0 },
        "syncEventCount": { "type": "integer", "minimum": 0 },
        "beatEventCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "analysisRef": {
      "type": "object",
      "required": ["id", "assetId", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "assetId": { "$ref": "#/$defs/idString" },
        "path": { "type": "string", "minLength": 1 },
        "thumbnailManifestPath": { "type": "string", "minLength": 1 },
        "waveformPath": { "type": "string", "minLength": 1 },
        "summary": { "$ref": "#/$defs/analysisSummary" }
      },
      "additionalProperties": false
    },
    "cutCandidate": {
      "type": "object",
      "required": ["id", "assetId", "startMs", "endMs", "durationMs"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "assetId": { "$ref": "#/$defs/idString" },
        "analysisRefId": { "$ref": "#/$defs/idString" },
        "startMs": { "type": "integer", "minimum": 0 },
        "endMs": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 1 },
        "sceneScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "motion": { "$ref": "#/$defs/motionSummary" },
        "luma": { "$ref": "#/$defs/lumaSummary" },
        "thumbnailPath": { "type": "string", "minLength": 1 },
        "tags": { "$ref": "#/$defs/stringArray" },
        "note": { "type": "string" },
        "status": { "$ref": "#/$defs/cutStatus", "default": "new" },
        "favorite": { "type": "boolean", "default": false },
        "binIds": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "bin": {
      "type": "object",
      "required": ["id", "name", "cutIds"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "name": { "type": "string", "minLength": 1 },
        "cutIds": { "$ref": "#/$defs/stringArray" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "marker": {
      "type": "object",
      "required": ["id", "timeMs", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "timeMs": { "type": "integer", "minimum": 0 },
        "label": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["marker", "beat", "chapter"],
          "default": "marker"
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["id", "startMs", "endMs", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "startMs": { "type": "integer", "minimum": 0 },
        "endMs": { "type": "integer", "minimum": 0 },
        "label": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "filterInstance": {
      "type": "object",
      "required": ["id", "type", "orderIndex"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "type": { "$ref": "#/$defs/supportedFilterType" },
        "enabled": { "type": "boolean", "default": true },
        "orderIndex": { "type": "integer", "minimum": 0 },
        "parameters": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/jsonPrimitive" },
          "default": {}
        },
        "mix": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
        "seed": { "type": "integer", "minimum": 0 },
        "automationLaneIds": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "filterStack": {
      "type": "object",
      "required": ["id", "name", "scope", "filters"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "name": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/filterStackScope" },
        "family": { "$ref": "#/$defs/presetFamily" },
        "filters": {
          "type": "array",
          "items": { "$ref": "#/$defs/filterInstance" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "sequenceClip": {
      "type": "object",
      "required": ["id", "assetId", "timelineStartMs", "sourceStartMs", "durationMs"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "assetId": { "$ref": "#/$defs/idString" },
        "cutId": { "$ref": "#/$defs/idString" },
        "timelineStartMs": { "type": "integer", "minimum": 0 },
        "sourceStartMs": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 1 },
        "overlayAssetId": { "$ref": "#/$defs/idString" },
        "overlayCutId": { "$ref": "#/$defs/idString" },
        "transition": { "$ref": "#/$defs/transitionStyle", "default": "cut" },
        "transitionDurationMs": { "type": "integer", "minimum": 0 },
        "transitionAssetId": { "$ref": "#/$defs/idString" },
        "transitionCutId": { "$ref": "#/$defs/idString" },
        "transitionOverlayAssetId": { "$ref": "#/$defs/idString" },
        "transitionOverlayCutId": { "$ref": "#/$defs/idString" },
        "presetId": { "$ref": "#/$defs/idString" },
        "stackOverrideId": { "$ref": "#/$defs/idString" },
        "tags": { "$ref": "#/$defs/stringArray" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "assistedGeneration": {
      "type": "object",
      "required": ["strategy"],
      "properties": {
        "strategy": { "$ref": "#/$defs/assistedGenerationStrategy" },
        "seed": { "type": "integer", "minimum": 0 },
        "parameters": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": true,
          "default": {}
        },
        "sourcePoolIds": { "$ref": "#/$defs/stringArray" },
        "durationTargetMs": { "type": "integer", "minimum": 0 },
        "exclusionTags": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "musicAlignment": {
      "type": "object",
      "properties": {
        "primaryAssetId": { "$ref": "#/$defs/idString" },
        "analysisRefId": { "$ref": "#/$defs/idString" },
        "syncMode": { "$ref": "#/$defs/syncMode", "default": "texture" },
        "beatMarkers": {
          "type": "array",
          "items": { "$ref": "#/$defs/marker" },
          "default": []
        },
        "chapterPoints": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "default": []
        },
        "snapToBeatGrid": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "required": ["id", "sequenceId", "name", "clips"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "sequenceId": { "$ref": "#/$defs/idString" },
        "name": { "type": "string", "minLength": 1 },
        "clips": {
          "type": "array",
          "items": { "$ref": "#/$defs/sequenceClip" },
          "default": []
        },
        "markers": {
          "type": "array",
          "items": { "$ref": "#/$defs/marker" },
          "default": []
        },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" },
          "default": []
        },
        "stackId": { "$ref": "#/$defs/idString" },
        "favorite": { "type": "boolean", "default": false },
        "locked": { "type": "boolean", "default": false },
        "assistedGeneration": { "$ref": "#/$defs/assistedGeneration" },
        "musicAlignment": { "$ref": "#/$defs/musicAlignment" }
      },
      "additionalProperties": false
    },
    "sequence": {
      "type": "object",
      "required": ["id", "name", "variantIds"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "name": { "type": "string", "minLength": 1 },
        "variantIds": { "$ref": "#/$defs/stringArray" },
        "defaultVariantId": { "$ref": "#/$defs/idString" },
        "favorite": { "type": "boolean", "default": false },
        "notes": { "type": "string" }
      },
