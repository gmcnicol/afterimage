{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterimage.local/schemas/shared-defs.schema.json",
  "$defs": {
    "idString": {
      "type": "string",
      "minLength": 1
    },
    "runtimeMode": {
      "type": "string",
      "enum": ["studio", "live-desktop", "live-appliance"]
    },
    "presetFamily": {
      "type": "string",
      "enum": ["vhs", "liminal", "imagined-futures", "glitch"]
    },
    "midiBindingMode": {
      "type": "string",
      "enum": ["set", "toggle", "scale", "trigger"]
    },
    "projectSource": {
      "type": "object",
      "required": ["id", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "path": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "hasVideo": { "type": "boolean", "default": true },
        "hasAudio": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "presetFilter": {
      "type": "object",
      "required": ["type", "amount"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "amount": { "type": "number", "minimum": 0, "maximum": 1 },
        "mix": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
        "seed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "preset": {
      "type": "object",
      "required": ["id", "name", "family", "filters"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "name": { "type": "string", "minLength": 1 },
        "family": { "$ref": "#/$defs/presetFamily" },
        "filters": {
          "type": "array",
          "items": { "$ref": "#/$defs/presetFilter" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "sequenceItem": {
      "type": "object",
      "required": ["id", "sourceId", "timelineStartMs", "sourceStartMs", "durationMs"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "sourceId": { "$ref": "#/$defs/idString" },
        "timelineStartMs": { "type": "integer", "minimum": 0 },
        "sourceStartMs": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 1 },
        "presetId": { "$ref": "#/$defs/idString" }
      },
      "additionalProperties": false
    },
    "sequence": {
      "type": "object",
      "required": ["id", "name", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "name": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/sequenceItem" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "sceneCut": {
      "type": "object",
      "required": ["timeMs", "score"],
      "properties": {
        "timeMs": { "type": "integer", "minimum": 0 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "analysisSummary": {
      "type": "object",
      "required": ["sceneCount"],
      "properties": {
        "sceneCount": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "probeStream": {
      "type": "object",
      "required": ["codecType"],
      "properties": {
        "codecType": {
          "type": "string",
          "enum": ["video", "audio", "subtitle", "data", "unknown"]
        },
        "codecName": { "type": "string" },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "sampleRate": { "type": "integer", "minimum": 0 },
        "channels": { "type": "integer", "minimum": 0 },
        "avgFrameRate": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "probeMetadata": {
      "type": "object",
      "required": ["durationMs", "streams"],
      "properties": {
        "formatName": { "type": "string" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "bitRate": { "type": "integer", "minimum": 0 },
        "streams": {
          "type": "array",
          "items": { "$ref": "#/$defs/probeStream" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "analysisRef": {
      "type": "object",
      "required": ["id", "sourceId", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "sourceId": { "$ref": "#/$defs/idString" },
        "path": { "type": "string", "minLength": 1 },
        "summary": { "$ref": "#/$defs/analysisSummary" }
      },
      "additionalProperties": false
    },
    "midiBinding": {
      "type": "object",
      "required": ["id", "source", "target", "mode"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/midiBindingMode" }
      },
      "additionalProperties": false
    },
    "midiMapping": {
      "type": "object",
      "required": ["id", "name", "bindings"],
      "properties": {
        "id": { "$ref": "#/$defs/idString" },
        "name": { "type": "string", "minLength": 1 },
        "bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/midiBinding" },
          "default": []
        }
      },
      "additionalProperties": false
    }
  }
}
