{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterimage.local/schemas/analysis.schema.json",
  "title": "Analysis Result",
  "type": "object",
  "required": ["id", "sourceId", "probe", "sceneCuts"],
  "properties": {
    "id": { "$ref": "https://afterimage.local/schemas/shared-defs.schema.json#/$defs/idString" },
    "sourceId": { "$ref": "https://afterimage.local/schemas/shared-defs.schema.json#/$defs/idString" },
    "probe": {
      "$ref": "https://afterimage.local/schemas/shared-defs.schema.json#/$defs/probeMetadata"
    },
    "sceneCuts": {
      "type": "array",
      "items": { "$ref": "https://afterimage.local/schemas/shared-defs.schema.json#/$defs/sceneCut" },
      "default": []
    },
    "summary": {
      "$ref": "https://afterimage.local/schemas/shared-defs.schema.json#/$defs/analysisSummary"
    }
  },
  "additionalProperties": false
}
