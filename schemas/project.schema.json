{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterimage.local/schemas/project.schema.json",
  "title": "Afterimage Project",
  "type": "object",
  "required": ["id", "name", "mode", "version", "sources", "presets", "sequence"],
  "properties": {
    "id": { "$ref": "https://afterimage.local/schemas/shared-defs.schema.json#/$defs/idString" },
    "name": { "type": "string", "minLength": 1 },
    "mode": { "$ref": "https://afterimage.local/schemas/shared-defs.schema.json#/$defs/runtimeMode" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "sources": {
      "type": "array",
      "items": { "$ref": "https://afterimage.local/schemas/shared-defs.schema.json#/$defs/projectSource" },
      "default": []
    },
    "presets": {
      "type": "array",
      "items": { "$ref": "https://afterimage.local/schemas/shared-defs.schema.json#/$defs/preset" },
      "default": []
    },
    "sequence": {
      "$ref": "https://afterimage.local/schemas/shared-defs.schema.json#/$defs/sequence"
    },
    "midiMappings": {
      "type": "array",
      "items": { "$ref": "https://afterimage.local/schemas/shared-defs.schema.json#/$defs/midiMapping" },
      "default": []
    },
    "analysisRefs": {
      "type": "array",
      "items": { "$ref": "https://afterimage.local/schemas/shared-defs.schema.json#/$defs/analysisRef" },
      "default": []
    }
  },
  "additionalProperties": false
}
