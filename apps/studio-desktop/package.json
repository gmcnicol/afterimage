{
  "name": "@afterimage/studio-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev": "concurrently -k \"pnpm dev:renderer\" \"pnpm dev:electron\" \"wait-on tcp:5173 file:dist-electron/electron/main.js && VITE_DEV_SERVER_URL=http://localhost:5173 electron ./dist-electron/electron/main.js\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "pnpm build:electron && vite build",
    "dist": "pnpm -r --filter @afterimage/studio-desktop... build && electron-builder --publish never",
    "dist:dir": "pnpm -r --filter @afterimage/studio-desktop... build && electron-builder --dir --publish never",
    "dist:mac": "pnpm -r --filter @afterimage/studio-desktop... build && electron-builder --mac zip dmg --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "node -e \"console.log('lint placeholder: @afterimage/studio-desktop')\"",
    "test": "vitest run",
    "test:smoke": "pnpm build && playwright test",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@afterimage/export-profiles": "workspace:*",
    "@afterimage/ffmpeg-compiler": "workspace:*",
    "@afterimage/media-analysis": "workspace:*",
    "@afterimage/midi-engine": "workspace:*",
    "@afterimage/preset-library": "workspace:*",
    "@afterimage/project-model": "workspace:*",
    "@afterimage/schema-validators": "workspace:*",
    "@afterimage/ui": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.21",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.afterimage.studio",
    "productName": "Afterimage Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!dist-electron/**/*.tsbuildinfo",
      "!**/*.map"
    ],
    "asar": true,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "zip",
        "dmg"
      ]
    }
  }
}
