{
  "name": "@afterimage/studio-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:renderer": "vite",
    "dev": "concurrently -k \"pnpm dev:renderer\" \"wait-on tcp:5173 && electron ./electron/main.js\"",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"console.log('lint placeholder: @afterimage/studio-desktop')\"",
    "test": "node -e \"console.log('test placeholder: @afterimage/studio-desktop')\""
  },
  "dependencies": {
    "@afterimage/ffmpeg-compiler": "workspace:*",
    "@afterimage/media-analysis": "workspace:*",
    "@afterimage/midi-engine": "workspace:*",
    "@afterimage/preset-library": "workspace:*",
    "@afterimage/project-model": "workspace:*",
    "@afterimage/schema-validators": "workspace:*",
    "@afterimage/ui": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "electron": "^40.8.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  }
}
